---
import type { ResearchExperienceEntry } from '../../data/types'
interface Props {
	entries: ResearchExperienceEntry[]
}
const { entries } = Astro.props
---

<ol class='rp-timeline'>
	{
		entries.map((entry) => (
			<li>
				<p class='rp-mono rp-muted'>
					<span>{entry.period}</span> · <span>{entry.kind}</span>
				</p>
				<h3>{entry.title}</h3>
			</li>
		))
	}
</ol>
