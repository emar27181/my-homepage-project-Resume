---
import ExternalLink from '../atoms/ExternalLink.astro'
import { getUi } from '../../data/ui'
import type { Language } from '@/v2/data/portfolio'
import type { ResearchProject } from '../../data/types'
interface Props {
	projects: ResearchProject[]
	lang: Language
}
const { projects, lang } = Astro.props
const ui = getUi(lang)
---

<div>
	{
		projects.map((project, index) => (
			<article class='rp-record' id={project.id}>
				<span class='rp-mono rp-muted'>
					{String(index + 1).padStart(2, '0')} / {project.year}
				</span>
				<h4>{project.title}</h4>
				<p>{project.summary}</p>
				<div class='rp-contribution'>
					<span class='rp-small-label'>{ui.role}</span>
					<p>{project.role}</p>
				</div>
				<p class='rp-mono rp-muted'>
					{ui.technologies}: {project.technologies.join(', ')}
				</p>
				{project.href && <ExternalLink href={project.href}>{ui.details}</ExternalLink>}
			</article>
		))
	}
</div>
