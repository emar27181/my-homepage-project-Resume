---
// Mirrors src/components/layout/Header.astro (v1) + the sticky `toc-nav`
// bar rendered around it in src/layouts/BaseLayout.astro: a sticky bar with
// the brand/mode-switch row on top, and a second row of section tabs whose
// current item is highlighted by scroll position (wired up in
// ResearchPortfolio.astro's script, the same `toc-active`-on-scroll idea as
// v1's `updateToc()`).
import type { SectionDef } from '../../data/types'

interface Props {
	brand: string
	v1Href: string
	v1Label: string
	v2Href: string
	v2Label: string
	otherLangHref: string
	otherLangLabel: string
	themeLabel: string
	sections: SectionDef[]
	contentsLabel: string
}
const {
	brand,
	v1Href,
	v1Label,
	v2Href,
	v2Label,
	otherLangHref,
	otherLangLabel,
	themeLabel,
	sections,
	contentsLabel
} = Astro.props
---

<header class='rp-header'>
	<div class='rp-header-inner'>
		<a class='rp-brand' href='#top'>
			<span class='rp-brand-dot' aria-hidden='true'></span>
			{brand}
		</a>
		<nav class='rp-header-nav' aria-label={v1Label}>
			<a class='rp-icon-link' href={v1Href} title={v1Label} aria-label={v1Label}>
				<svg
					viewBox='0 0 24 24'
					width='18'
					height='18'
					fill='none'
					stroke='currentColor'
					stroke-width='2'
					stroke-linecap='round'
					stroke-linejoin='round'
					aria-hidden='true'
				>
					<path d='M3 11 12 3l9 8'></path>
					<path d='M5 10v10a1 1 0 0 0 1 1h5v-6h2v6h5a1 1 0 0 0 1-1V10'></path>
				</svg>
			</a>
			<a class='rp-icon-link' href={v2Href} title={v2Label} aria-label={v2Label}>
				<svg
					viewBox='0 0 24 24'
					width='18'
					height='18'
					fill='none'
					stroke='currentColor'
					stroke-width='2'
					stroke-linecap='round'
					stroke-linejoin='round'
					aria-hidden='true'
				>
					<path d='m7 11 2-2-2-2'></path>
					<path d='M11 13h4'></path>
					<rect width='18' height='18' x='3' y='3' rx='2' ry='2'></rect>
				</svg>
			</a>
			<a href={otherLangHref}>{otherLangLabel}</a>
			<button type='button' class='rp-theme-toggle' data-rp-set-theme aria-label={themeLabel}>
				<svg
					class='rp-theme-icon rp-theme-icon--light'
					viewBox='0 0 24 24'
					width='16'
					height='16'
					fill='none'
					stroke='currentColor'
					stroke-width='2'
					stroke-linecap='round'
					aria-hidden='true'
				>
					<circle cx='12' cy='12' r='4'></circle>
					<path
						d='M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4'
					></path>
				</svg>
				<svg
					class='rp-theme-icon rp-theme-icon--dark'
					viewBox='0 0 24 24'
					width='16'
					height='16'
					fill='none'
					stroke='currentColor'
					stroke-width='2'
					stroke-linecap='round'
					stroke-linejoin='round'
					aria-hidden='true'
				>
					<path d='M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5Z'></path>
				</svg>
			</button>
		</nav>
	</div>
	{
		sections.length > 0 && (
			<div class='rp-toc-row'>
				<nav class='rp-toc-nav' aria-label={contentsLabel}>
					{sections.map((section, index) => (
						<a
							class='rp-toc-link'
							href={`#${section.id}`}
							data-rp-toc-link={section.id}
							aria-label={section.title}
							title={section.title}
						>
							<span class='rp-toc-num' aria-hidden='true'>
								{String(index + 1).padStart(2, '0')}
							</span>
							<span class='rp-toc-text' aria-hidden='true'>
								{section.title}
							</span>
						</a>
					))}
				</nav>
			</div>
		)
	}
</header>
