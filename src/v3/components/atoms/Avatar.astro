---
// No profile photo exists anywhere in this project (checked src/assets and
// src/pages/index.astro), so rather than fabricate one, the sidebar/hero
// show a plain initials circle — same idea as a chat app's fallback avatar.
interface Props {
	initials: string
}
const { initials } = Astro.props
---

<span class='rp-avatar' aria-hidden='true'>{initials}</span>
