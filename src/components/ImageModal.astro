---
// components/ImageModal.astro
---

<div id="image-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black bg-opacity-75 p-4">
	<div class="relative flex max-h-full max-w-full flex-col items-center gap-3">
		<button
			id="close-modal"
			class="absolute -top-10 right-0 text-white hover:text-gray-300 text-2xl font-bold z-10"
			aria-label="Close modal"
		>
			&times;
		</button>
		<img
			id="modal-image"
			class="max-h-[85vh] max-w-[90vw] object-contain rounded-lg shadow-2xl"
			alt=""
		/>
		<a
			id="modal-caption"
			class="hidden text-sm text-white/80 underline hover:text-white"
			target="_blank"
			rel="noopener noreferrer"
		></a>
	</div>
</div>

<script>
	const modal = document.getElementById('image-modal') as HTMLElement;
	const modalImage = document.getElementById('modal-image') as HTMLImageElement;
	const closeButton = document.getElementById('close-modal') as HTMLElement;
	const modalCaption = document.getElementById('modal-caption') as HTMLAnchorElement;

	function closeModal() {
		modal.classList.add('hidden');
		modal.classList.remove('flex');
		document.body.style.overflow = 'auto';
	}

	function openModal(src: string, alt: string, info?: { caption?: string; href?: string }) {
		modalImage.src = src;
		modalImage.alt = alt;

		if (info?.caption) {
			modalCaption.textContent = info.caption;
			modalCaption.classList.remove('hidden');
			if (info.href) {
				modalCaption.href = info.href;
			} else {
				modalCaption.removeAttribute('href');
			}
		} else {
			modalCaption.classList.add('hidden');
		}

		modal.classList.remove('hidden');
		modal.classList.add('flex');
		document.body.style.overflow = 'hidden';
	}

	closeButton.addEventListener('click', closeModal);

	modal.addEventListener('click', (e) => {
		if (e.target === modal) {
			closeModal();
		}
	});

	document.addEventListener('keydown', (e) => {
		if (e.key === 'Escape' && !modal.classList.contains('hidden')) {
			closeModal();
		}
	});

	(window as any).openImageModal = openModal;
</script>
