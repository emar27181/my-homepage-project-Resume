---
import LanguageSwitcher from '../LanguageSwitcher.astro'
import { getLanguageFromPath, getLocalizedPath } from '../../utils/i18n'
import { Icon } from 'astro-icon/components'
import IconButton from '@/components/IconButton.astro'

const currentLanguage = getLanguageFromPath(Astro.url.pathname)
const homeLink = getLocalizedPath('/', currentLanguage)
const homeTitle = currentLanguage === 'en' ? 'Home' : 'ホームに戻る'
const homeSrLabel = currentLanguage === 'en' ? 'Home' : 'ホーム'
const v2Link = getLocalizedPath('/v2', currentLanguage)
const v2Title =
	currentLanguage === 'en' ? 'Try the terminal-style portfolio' : 'ターミナル版ポートフォリオを試す'
const v2SrLabel =
	currentLanguage === 'en' ? 'Terminal-style portfolio' : 'ターミナル版ポートフォリオ'
const v3Link = getLocalizedPath('/v3', currentLanguage)
const v3Title =
	currentLanguage === 'en' ? 'Try the research portfolio' : '研究者ポートフォリオ版を試す'
const v3SrLabel = currentLanguage === 'en' ? 'Research portfolio' : '研究者ポートフォリオ'
---

<header class='flex w-full flex-wrap py-3 text-sm sm:flex-nowrap sm:justify-start'>
	<nav
		class='relative mx-auto flex w-full items-center justify-between sm:flex sm:items-center'
		aria-label='global'
	>
		<a class='flex-none text-xl font-semibold' href={homeLink} aria-label='Brand'>Home</a>

		<div class='flex flex-row items-center gap-x-3 sm:gap-x-4'>
			<LanguageSwitcher />

			{
				/* Header icon cluster — right-to-left: hamburger (mobile toc
				 toggle), night mode, research (v3), terminal (v2), home (v1).
				 Kept together with a tight, consistent gap (rather than the
				 rest of the header's wider gap) since these are one group of
				 peer navigation controls, all the same IconButton size. */
			}
			<div class='flex flex-row items-center gap-x-1'>
				<IconButton as='a' href={homeLink} title={homeTitle}>
					<span class='sr-only'>{homeSrLabel}</span>
					<Icon name='house' class='h-[1.2rem] w-[1.2rem]' />
				</IconButton>

				<IconButton as='a' href={v2Link} title={v2Title}>
					<span class='sr-only'>{v2SrLabel}</span>
					<Icon name='square-terminal' class='h-[1.2rem] w-[1.2rem]' />
				</IconButton>

				<IconButton as='a' href={v3Link} title={v3Title}>
					<span class='sr-only'>{v3SrLabel}</span>
					<Icon name='graduation-cap' class='h-[1.2rem] w-[1.2rem]' />
				</IconButton>

				<IconButton id='toggleDarkMode'>
					<span class='sr-only'>Dark Theme</span>
					<Icon
						name='sun'
						class='h-[1.2rem] w-[1.2rem] rotate-0 scale-100 transition-all dark:hidden dark:-rotate-90 dark:scale-0'
					/>
					<Icon
						name='moon'
						class='hidden h-[1.2rem] w-[1.2rem] rotate-90 scale-0 transition-all dark:block dark:rotate-0 dark:scale-100'
					/>
				</IconButton>

				<IconButton id='toggleToc' class='sm:hidden' aria-label='Toggle navigation'>
					<Icon name='menu' class='h-[1.2rem] w-[1.2rem]' />
				</IconButton>
			</div>
		</div>
	</nav>
</header>

<script>
	function getCurrentTheme() {
		return localStorage.getItem('theme')
	}
	const toggleDarkModeButton = document.getElementById('toggleDarkMode')

	toggleDarkModeButton?.addEventListener('click', () => {
		const toggleDarkModeEvent = new CustomEvent('theme-change', {
			detail: { theme: getCurrentTheme() === 'light' ? 'dark' : 'light' }
		})
		document.dispatchEvent(toggleDarkModeEvent)
	})

	const toggleTocButton = document.getElementById('toggleToc')
	const tocNav = document.getElementById('toc-nav')

	toggleTocButton?.addEventListener('click', () => {
		tocNav?.classList.toggle('hidden')
	})
</script>
