---
// v2 — "My Portfolio is a Computer". A standalone experience: its own
// dark/green shell, not the site's normal Header/Footer/theme (v1 stays
// untouched at "/"). See docs/ARCHITECTURE.md and docs/DESIGN.md.
//
// Shared by src/pages/v2/index.astro (lang="ja") and
// src/pages/en/v2/index.astro (lang="en") so the two routes never drift —
// only the `lang` prop differs, everything else (markup, data source) is
// the same file.
import BaseHead from '@/components/BaseHead.astro'
import '@/v2/styles/terminal.css'

import Chip from '@/v2/components/atoms/Chip.astro'
import SegmentedControl from '@/v2/components/molecules/SegmentedControl.astro'
import { getPortfolio, type Language } from '@/v2/data/portfolio'

interface Props {
	lang?: Language
}

const { lang = 'ja' } = Astro.props as Props
const { hobbies, profile, projects, research, skills } = getPortfolio(lang)

const otherLang: Language = lang === 'en' ? 'ja' : 'en'
const v1Href = lang === 'en' ? '/en' : '/'
const otherLangHref = otherLang === 'en' ? '/en/v2' : '/v2'
const otherLangLabel = otherLang === 'en' ? 'EN' : 'JA'
const otherLangTitle = otherLang === 'en' ? 'Switch to English' : '日本語に切り替え'
const backTitle = lang === 'en' ? 'Back to the classic resume page' : '戻る: 従来のレジュメページ'
const backSrOnly = lang === 'en' ? 'Classic resume page' : '従来のレジュメページ'

const description =
	lang === 'en'
		? `${profile.name}'s portfolio — explore it as a terminal.`
		: `${profile.name} のポートフォリオ — ターミナルとして探索できます。`
---

<html lang={lang}>
	<head>
		<BaseHead title='Portfolio Terminal' description={description} />
	</head>
	<body class='pf-computer'>
		<header class='pf-header'>
			<span class='pf-header__prompt'>{profile.handle}@portfolio: ~</span>
			<div class='pf-header__actions'>
				<Chip as='a' href={v1Href} size='sm' title={backTitle}>
					<span class='sr-only'>{backSrOnly}</span>v1
				</Chip>
				<Chip as='a' href={otherLangHref} size='sm' title={otherLangTitle}>{otherLangLabel}</Chip>
				{
					/* collageモードは一時的に非表示(コード・データはそのまま)。
					 再表示するにはoptionsに { value: 'collage', label: 'collage' } を戻すだけでよい。 */
				}
				<SegmentedControl
					name='display mode'
					value='terminal'
					options={[{ value: 'terminal', label: 'terminal' }]}
				/>
			</div>
		</header>

		<main class='pf-main'>
			<section id='pf-terminal-view' class='pf-view'>
				<div class='pf-terminal-layout'>
					<div class='pf-window' id='pf-window'>
						<div class='pf-window__titlebar' aria-hidden='true'>
							<span class='pf-dot pf-dot--red'></span>
							<span class='pf-dot pf-dot--yellow'></span>
							<span class='pf-dot pf-dot--green'></span>
							<span class='pf-window__title'>{profile.handle}@portfolio</span>
						</div>
						<div class='pf-window__body' id='pf-output' role='log' aria-live='polite'>
							{
								/* The input line lives inside the scrolling output, as its
								 last child, so it behaves like a real terminal — you type
								 right after the last printed line, not in a separate fixed
								 bar. app.ts keeps it pinned there by inserting every new
								 printed line before it rather than appending after it. */
							}
							<div class='pf-window__input-row' id='pf-input-row'>
								<span class='pf-prompt' id='pf-prompt'></span>
								<input
									id='pf-input'
									class='pf-input'
									type='text'
									autocomplete='off'
									autocapitalize='off'
									spellcheck='false'
									aria-label='terminal input'
								/>
							</div>
						</div>
						<div class='pf-mobile-keys' id='pf-mobile-keys'>
							<button type='button' class='pf-chip pf-chip--md' data-key='tab'>Tab</button>
							<button type='button' class='pf-chip pf-chip--md' data-key='enter'>Enter ⏎</button>
						</div>
						{
							/* Quick-launch buttons for common commands — typing on a phone's
							 virtual keyboard is slow, so tapping is the primary way in on
							 mobile. Commands that take an argument (cd/cat/open) insert
							 "cmd " and leave the cursor there instead of running immediately. */
						}
						<div class='pf-mobile-commands' id='pf-mobile-commands'>
							<button type='button' class='pf-chip pf-chip--sm' data-cmd='ls'>ls</button>
							<button type='button' class='pf-chip pf-chip--sm' data-cmd='cd '>cd</button>
							<button type='button' class='pf-chip pf-chip--sm' data-cmd='cat '>cat</button>
							<button type='button' class='pf-chip pf-chip--sm' data-cmd='tree'>tree</button>
							<button type='button' class='pf-chip pf-chip--sm' data-cmd='open '>open</button>
							<button type='button' class='pf-chip pf-chip--sm' data-cmd='whoami'>whoami</button>
							<button type='button' class='pf-chip pf-chip--sm' data-cmd='help'>help</button>
						</div>
					</div>
					<aside id='pf-preview' class='pf-preview' hidden></aside>
				</div>
			</section>

			<section id='pf-collage-view' class='pf-view' hidden>
				<div class='pf-collage'>
					<div class='pf-card pf-card--wide' data-tag='about/profile.md'>
						<h3>{profile.name} / {profile.nameJa}</h3>
						<p>{profile.role} — {profile.location}</p>
						<p>{profile.education}</p>
						{profile.bio.map((line) => <p>{line}</p>)}
						<div class='pf-tech'>
							{
								profile.links.map((l) => (
									<Chip as='a' href={l.href} size='sm' target='_blank' rel='noopener noreferrer'>
										{l.label}
									</Chip>
								))
							}
						</div>
					</div>

					{
						projects.map((p) => (
							<div class='pf-card' data-tag={`projects/${p.slug}`}>
								<h3>{p.heading}</h3>
								<p>{p.summary}</p>
								<div class='pf-tech'>
									{p.tech.map((t) => (
										<Chip size='sm'>{t}</Chip>
									))}
								</div>
								{p.href && (
									<Chip as='a' href={p.href} size='sm' target='_blank' rel='noopener noreferrer'>
										open →
									</Chip>
								)}
							</div>
						))
					}

					<div class='pf-card pf-card--wide pf-card--tilt' data-tag='research/'>
						<h3>Research</h3>
						{
							research.map((r) => (
								<p>
									{r.heading}
									{r.date ? ` — ${r.date}` : ''}: {r.summary}
								</p>
							))
						}
					</div>

					<div class='pf-card' data-tag='skills.json'>
						<h3>Skills</h3>
						{
							skills.map((group) => (
								<p>
									{group.label}: {group.items.join(', ')}
								</p>
							))
						}
					</div>

					<div class='pf-card' data-tag='hobbies.md'>
						<h3>Hobbies</h3>
						{
							hobbies.map((h) => (
								<p>
									{h.heading} — {h.summary}
								</p>
							))
						}
					</div>
				</div>
			</section>
		</main>

		<script>
			import '@/v2/terminal/app'
		</script>
	</body>
</html>
