---
import PageLayout from '../../layouts/BaseLayout.astro'
import Section from '../../components/Section.astro'
import Card from '../../components/Card.astro'
import ProjectCard from '../../components/ProjectCard.astro'
import SkillLayout from '../../components/SkillLayout.astro'
import '../../styles/app.css'
import Gallery from '../../components/Gallery.astro'
import ImageModal from '../../components/ImageModal.astro'
import { useTranslations } from '../../utils/i18n'

import { Image } from 'astro:assets'
import astro from '../../assets/about-astro.png'

const t = useTranslations('en')

const frontend = ['js', 'ts', 'html', 'css', 'react', 'nextjs', 'p5js', 'flask', 'astro']
const backend = ['python', 'c', 'java']
const tool = ['git', 'vscode']
---

<PageLayout meta={{ title: 'emar27181-portfolio' }}>
	<nav
		slot='toc'
		class='flex flex-wrap items-center justify-center gap-x-3 gap-y-1 font-satoshi text-[0.92rem]'
	>
		<a class='toc-link' href='#projects'>Projects</a>
		<a class='toc-link' href='#research'>Research</a>
		<a class='toc-link' href='#publications'>Publications</a>
		<a class='toc-link' href='#skills'>Skills</a>
		<a class='toc-link' href='#education'>Education</a>
		<a class='toc-link' href='#hobbies'>Hobbies</a>
		<a class='toc-link' href='#qualifications'>Qualifications</a>
		<a class='toc-link' href='#gallery'>Gallery</a>
	</nav>
	<div class='flex w-full flex-col gap-y-10'>
		<section class='flex flex-col items-center gap-y-7'>
			<Image
				src={astro}
				alt='profile photo'
				class='h-28 w-auto rounded-full bg-[#EEEEEE] p-2'
				loading='eager'
			/>

			<div class='flex flex-col items-center gap-y-4'>
				<h1 class='text-center text-3xl font-bold'>
					<span class='hidden sm:inline'>Ryunosuke Ema | 江馬 龍之介</span>
					<span class='sm:hidden'>
						Ryunosuke Ema<br />江馬 龍之介
					</span>
				</h1>
			</div>
		</section>

		<Section title={t.about}>
			<p class='text-muted-foreground'>
				{t.siteDescription}
				{t.githubLink}
				<a
					class='link'
					target='_blank'
					href='https://github.com/emar27181/my-homepage-project-Resume'
				>
					{t.githubLinkText}
				</a>
				{t.githubLinkSuffix}
				<br />
				<span class='text-xs text-muted-foreground/60'>Last updated: September 9, 2026</span>
			</p>
		</Section>

		<Section title={t.aboutMe}>
			<p class='text-muted-foreground'>
				{t.profileDescription}
				<a
					href='https://emar27181-gallery-portfolio.netlify.app/'
					class='link'
					target='_blank'
					rel='noopener noreferrer'>{t.galleryLinkText}</a
				>
				{t.galleryLinkSuffix}
				<br /><br />

				MyLab: <a class='link' target='_blank' href='https://int.cs.meiji.ac.jp/'>
					https://int.cs.meiji.ac.jp/</a
				><br />
				GitHub: <a class='link' target='_blank' href='https://github.com/emar27181'
					>https://github.com/emar27181</a
				><br />
				Instagram: <a class='link' target='_blank' href='https://www.instagram.com/emar27181/'>
					https://www.instagram.com/emar27181/</a
				><br />
				Gmail: <a class='link' target='_blank' href='mailto: ryunosukeema.job@gmail.com'
					>ryunosukeema.job@gmail.com</a
				><br />
			</p>
		</Section>

		<Section title={t.projects} id='projects'>
			<div class='grid grid-cols-2 gap-2 sm:gap-3'>
				<ProjectCard
					href='https://emar27181-gallery-portfolio.netlify.app/'
					heading={t.galleryPortfolio}
					subheading={t.galleryPortfolioDesc}
					imagePath='/src/assets/gallery-portfolio.png'
					altText='Example'
					class='w-full'
					target='_blank'
				/>

				<ProjectCard
					href='https://emar27181-portfolio.netlify.app/'
					heading={t.portfolioSite}
					subheading={t.portfolioSiteDesc}
					altText='Example'
					imagePath='/src/assets/portfolio.png'
					class='w-full'
					target='_blank'
				/>

				<ProjectCard
					href='https://flex-railway-map.netlify.app/'
					heading='Flex Railway Map'
					subheading='A customizable railway map website that allows users to create and display flexible rail network visualizations.'
					subheadingShort='A railway map site that shows only the lines you need.'
					imagePath='/src/assets/flex-rail-map.png'
					altText='Flex Railway Map'
					class='w-full'
					target='_blank'
				/>

				<ProjectCard
					href='https://nodoame27181.netlify.app/'
					heading={t.gamePortfolio}
					subheading={t.gamePortfolioDesc}
					subheadingShort='A portfolio of my gaming accounts and play records.'
					imagePath='/src/assets/nodoame_portfolio.png'
					altText='Example'
					class='w-full'
					target='_blank'
				/>

				<ProjectCard
					href='https://music-atlas.netlify.app/'
					heading='Music Atlas'
					subheading='A site that summarizes statistics about the music I listen to, including analysis of which songs suit karaoke and statistical plots of my listening distribution.'
					subheadingShort='Statistics on the music I listen to, including karaoke analysis.'
					imagePath='/src/assets/music-atlas.jpg'
					altText='Music Atlas'
					class='w-full'
					target='_blank'
				/>

				<ProjectCard
					href='https://throw-frow-darts.netlify.app/'
					heading='ThrowFlowDarts'
					subheading='An app that turns otherwise dull at-home darts scorekeeping into a game-like experience through sound and design.'
					subheadingShort='At-home darts scorekeeping made game-like with sound and design.'
					imagePath='/src/assets/throw-frow-darts.jpg'
					altText='ThrowFlowDarts'
					class='w-full'
					target='_blank'
				/>

				<ProjectCard
					href='https://waste-tax.netlify.app/onboarding'
					heading='TAKUS'
					subheading='A site rebuilt from a project I created during training, reworked so that it can be used in everyday life.'
					subheadingShort='A training project rebuilt for everyday use.'
					imagePath='/src/assets/waste-tax.jpg'
					altText='TAKUS'
					class='w-full'
					target='_blank'
				/>

				<ProjectCard
					href='https://window-brain.netlify.app/'
					heading='Window Brain'
					subheading='A site that turns an unused monitor into a stylish dashboard, letting you arrange and customize widgets such as a clock, BGM, and weather.'
					subheadingShort='Turn an unused monitor into a customizable widget dashboard.'
					imagePath='/src/assets/window-brain.jpg'
					altText='Window Brain'
					class='w-full'
					target='_blank'
				/>

				<ProjectCard
					href='https://way-point-map.netlify.app/'
					heading='Way Point Map'
					subheading='A map-based site for browsing golf courses and comparing them by price per ball and unit cost, with filtering and heatmap plots.'
					subheadingShort='Compare golf courses on a map by price per ball.'
					imagePath='/src/assets/way-point-map.jpg'
					altText='Way Point Map'
					class='w-full'
					target='_blank'
				/>

				<ProjectCard
					href='https://color-recommend.netlify.app/'
					heading={t.colorRecommendApp}
					subheading={t.colorRecommendAppDesc}
					imagePath='/src/assets/color-recommend-site.jpg'
					altText='Example'
					class='w-full'
					target='_blank'
				/>

				<ProjectCard
					href='https://valorant-point-viewer.netlify.app/'
					heading={t.valorantPointViewer}
					subheading={t.valorantPointViewerDesc}
					subheadingShort='Watch VALORANT lineup videos pinned to each map.'
					imagePath='/src/assets/valopoint.png'
					altText='Example'
					class='w-full'
					target='_blank'
				/>

				<ProjectCard
					href='https://mahjong-yaku-visualizer.netlify.app/'
					heading={t.mahjongYakuVisualizer}
					subheading={t.mahjongYakuVisualizerDesc}
					imagePath='/src/assets/mahjong-vis.png'
					altText='Mahjong Yaku Visualizer'
					class='w-full'
					target='_blank'
				/>

				{
					/*
					<ProjectCard
					href='https://juqs-map.netlify.app/'
					heading={t.juqsMap}
					subheading={t.juqsMapDesc}
					imagePath='/src/assets/juqs-map.png'
					altText='Example'
					class='w-full'
					target='_blank'
					/>
				*/
				}

				{
					/*
					<ProjectCard
					href='https://emar27181.github.io/'
					heading={t.p5jsBrowser}
					subheading={t.p5jsBrowserDesc}
					imagePath='/src/assets/demo-site.png'
					altText='Example'
					class='w-full'
					target='_blank'
					/>
				*/
				}
			</div>
		</Section>

		<Section title={t.research} id='research'>
			<Card heading={t.researchTitle} subheading={t.researchDescription}>
				<div style='position: relative; padding-bottom: 56.25%; height: 0; overflow: hidden;'>
					<iframe
						src='https://www.youtube.com/embed/h5IxvhB8jNE'
						style='position: absolute; top: 0; left: 0; width: 100%; height: 100%;'
						allowfullscreen></iframe>
				</div>
				<ul class='ml-4 list-disc text-muted-foreground'>
					<li>
						<a class='link' target='_blank' href='https://color-recommend.netlify.app/'>Demo Site</a
						>
					</li>
				</ul>
			</Card>
		</Section>

		<Section title={t.publications} id='publications'>
			<div class='grid grid-cols-1 gap-3 sm:grid-cols-2'>
				<Card
					heading='Interaction 2024 Demo Presentation'
					subheading='Demo presentation titled "Development of illustration creation support tool through color scheme visualization and color scheme technique estimation".'
					subheadingShort='A demo presentation on an illustration creation support tool.'
					date='March 2024'
				>
					<ul class='ml-4 list-disc text-muted-foreground'>
						<li>
							<a class='link' target='_blank' href='https://www.interaction-ipsj.org/2024/'
								>Conference Link</a
							>
						</li>
						<li>
							<a
								class='link'
								target='_blank'
								href='https://www.interaction-ipsj.org/proceedings/2024/data/bib/3B-27.html'
								>Paper Link</a
							>
						</li>
						<li>
							<a
								class='link'
								target='_blank'
								href='https://int.cs.meiji.ac.jp/2024/03/%e3%82%a4%e3%83%a9%e3%82%b9%e3%83%88%e3%81%ae%e5%88%b6%e4%bd%9c%e3%82%92%e5%8a%a9%e3%81%91%e3%82%8b%e9%85%8d%e8%89%b2%e6%94%af%e6%8f%b4%e3%82%b7%e3%82%b9%e3%83%86%e3%83%a0/'
								>Description Link</a
							>
						</li>
						<br />
						<div style='position: relative; padding-bottom: 56.25%; height: 0; overflow: hidden;'>
							<iframe
								src='https://www.youtube.com/embed/RDHGUdwDi1A'
								style='position: absolute; top: 0; left: 0; width: 100%; height: 100%;'
								allowfullscreen></iframe>
						</div>
					</ul>
				</Card>
				<Card
					heading='Entertainment Computing 2024 Oral & Demo Presentation'
					date='September 2024'
					subheading='Oral and demo presentation titled "Study of color palettes that recommend color schemes suitable for users concepts".'
				>
					<ul class='ml-4 list-disc text-muted-foreground'>
						<li>
							<a class='link' target='_blank' href='https://ec2024.entcomp.org/'>Conference Link</a>
						</li>
						<li>
							<a
								class='link'
								target='_blank'
								href='https://ipsj.ixsq.nii.ac.jp/ej/?action=pages_view_main&active_action=repository_view_main_item_detail&item_id=238714&item_no=1&page_id=13&block_id=8'
								>Paper Link</a
							>
						</li>
						<br />
						<div style='position: relative; padding-bottom: 56.25%; height: 0; overflow: hidden;'>
							<iframe
								src='https://www.youtube.com/embed/1PHFpr4gAR4'
								style='position: absolute; top: 0; left: 0; width: 100%; height: 100%;'
								allowfullscreen></iframe>
						</div>
					</ul>
				</Card>
				<Card
					heading='IPSJ Journal: Entertainment Computing Special Issue (Under Review)'
					date='February 2026 (Under Review)'
					subheading='Currently under review for submission to the IPSJ Journal Entertainment Computing special issue.'
					altText=''
					imageClass='h-12 w-auto md:-left-16'
				>
					<ul class='ml-4 list-disc text-muted-foreground'>
						<li>
							<a class='link' target='_blank' href='https://www.ipsj.or.jp/journal/cfp/26-T.html'
								>Conference Link</a
							>
						</li>
						<br />
						<div style='position: relative; padding-bottom: 56.25%; height: 0; overflow: hidden;'>
							<iframe
								src='https://www.youtube.com/embed/h5IxvhB8jNE'
								style='position: absolute; top: 0; left: 0; width: 100%; height: 100%;'
								allowfullscreen></iframe>
						</div>
					</ul>
				</Card>
			</div>
		</Section>

		<Section title={t.skills} id='skills'>
			<SkillLayout title='Frontend' skills={frontend} />
			<SkillLayout title='Backend' skills={backend} />
			<SkillLayout title='Tool' skills={tool} />
			<div class='flex flex-col gap-y-2 md:flex-row md:gap-x-5 md:gap-y-0'>
				<h3 class='w-1/5 font-medium'>AI</h3>
				<div class='flex flex-wrap gap-2'>
					{
						[
							{ key: 'claude-code', label: 'Claude Code' },
							{ key: 'gemini', label: 'Gemini' },
							{ key: 'chatgpt', label: 'ChatGPT' },
							{ key: 'genspark', label: 'Genspark' }
						].map(({ key, label }) => (
							<span
								class='skill-badge inline-flex cursor-pointer items-center rounded-md border border-border bg-muted px-3 py-1 text-sm font-medium text-foreground/80'
								data-skill={key}
							>
								{label}
							</span>
						))
					}
				</div>
			</div>
			<br />

			<div class='grid grid-cols-1 gap-4 sm:grid-cols-2'>
				<img
					src='https://github-profile-summary-cards.vercel.app/api/cards/stats?username=emar27181&theme=transparent'
					class='w-full'
				/>
				<img
					src='https://github-profile-summary-cards.vercel.app/api/cards/repos-per-language?username=emar27181&theme=transparent'
					class='w-full'
				/>
			</div>
		</Section>

		<Section title={t.education} id='education'>
			<Card
				heading={t.highSchoolEnrollment}
				date='April 2017'
				altText='Lorem, ipsum dolor sit'
				imageClass='h-12 w-auto md:-left-16'
			/>

			<Card
				heading={t.highSchoolGraduation}
				date='March 2020'
				altText='Lorem, ipsum dolor sit'
				imageClass='h-12 w-auto md:-left-16'
			/>

			<Card
				heading={t.universityEnrollment}
				date='April 2020'
				altText='Lorem, ipsum dolor sit'
				imageClass='h-12 w-auto md:-left-16'
			/>

			<Card
				heading={t.universityGraduation}
				date='March 2024'
				altText='Lorem, ipsum dolor sit'
				imageClass='h-12 w-auto md:-left-16'
			/>

			<Card
				heading={t.graduateSchoolEnrollment}
				date='April 2024'
				altText='Lorem, ipsum dolor sit'
				imageClass='h-12 w-auto md:-left-16'
			/>

			<Card
				heading={t.graduateSchoolGraduation}
				date='March 2026'
				altText='Lorem, ipsum dolor sit'
				imageClass='h-12 w-auto md:-left-16'
			/>
		</Section>

		<Section title={t.hobbies} id='hobbies'>
			<div class='grid grid-cols-2 gap-2 sm:gap-3'>
				<Card
					heading={t.illustrationHobby}
					subheading={t.illustrationDesc}
					subheadingShort='Drawing since childhood, from copies to logo design.'
					altText='Lorem, ipsum dolor sit'
					imageClass='h-12 w-auto md:-left-16'
				>
					<a
						href='https://emar27181-gallery-portfolio.netlify.app/'
						class='underline'
						target='_blank'
						rel='noopener noreferrer'>{t.illutWorksLink}</a
					>

					<div style='position: relative; padding-bottom: 56.25%; height: 0; overflow: hidden;'>
						<iframe
							src='https://www.youtube.com/embed/1-tDSvjpxn4'
							style='position: absolute; top: 0; left: 0; width: 100%; height: 100%;'
							allowfullscreen></iframe>
					</div>
				</Card>

				<Card
					heading={t.sportsHobby}
					subheading={t.sportsDesc}
					subheadingShort='Golf, table tennis, tennis and snowboarding.'
					altText='Lorem, ipsum dolor sit'
					imageClass='h-12 w-auto md:-left-16'
				/>

				<Card
					heading={t.gamingHobby}
					subheading={t.gamingDesc}
					subheadingShort='Mainly FPS games. I once hosted a prize tournament for APEX.'
					altText='Lorem, ipsum dolor sit'
					imageClass='h-12 w-auto md:-left-16'
				/>
			</div>
		</Section>

		<Section title={t.certifications} id='qualifications'>
			<Card
				as='a'
				heading={t.englishTest}
				date='July 2019'
				altText='Lorem, ipsum dolor sit'
				imageClass='h-11 w-auto md:-left-16'
			/>
			<Card
				as='a'
				heading={t.drivingLicense}
				date='August 2020'
				altText='Lorem, ipsum dolor sit'
				imageClass='h-11 w-auto md:-left-16'
			/>
		</Section>

		<Section title={t.gallery} id='gallery' />
	</div>

	<div class='mt-[12px]'><Gallery /></div>

	<p>
		<a
			href='https://emar27181-gallery-portfolio.netlify.app/'
			class='link'
			target='_blank'
			rel='noopener noreferrer'>{t.galleryLinkText}</a
		>
		{t.moreWorksLink}
	</p>

	<ImageModal />
</PageLayout>
